// A floating island: transparent layer with one centered pill of modules.
{
    "layer": "top",
    "position": "top",
    "height": 48,
    "margin": "8px 12px 0px",
    "spacing": 0,

    "modules-left": [],
    "modules-center": ["group/island"],
    "modules-right": [],

    "group/island": {
        "orientation": "horizontal",
        "modules": [
            "custom/arch-logo",
            "sway/workspaces",
            "sway/mode",
            "custom/cava-internal",
            "mpd#2",
            "mpd#3",
            "mpd#4",
            "mpd",
            "clock",
            "network",
            "disk",
            "cpu",
            "memory",
            "pulseaudio",
            "backlight",
            "battery",
            "idle_inhibitor",
            "custom/power",
            "tray"
        ]
    },

// Load Modules

  "include": ["~/.config/waybar/modules.jsonc"],

}
