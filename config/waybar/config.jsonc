// A floating island: transparent layer with one centered pill of modules.
{
    "layer": "top",
    "position": "top",
    "height": 50,
    "margin": "8px 12px 0px",
    "spacing": 0,

    "modules-left": [],
    "modules-center": ["group/island"],
    "modules-right": [],

    "group/island": {
        "orientation": "horizontal",
        "modules": [
            "custom/arch-logo",
            "sway/workspaces",
            "sway/mode",
            "custom/cava-internal",
            "custom/media-prev",
            "custom/media-toggle",
            "custom/media-next",
            "mpris",
            "clock",
            "network",
            "backlight",
            "pulseaudio",
            "custom/microphone",
            "battery",
            "disk",
            "cpu",
            "memory",
            "bluetooth",
            "custom/screen-recorder",
            "idle_inhibitor",
            "custom/power",
            "custom/pacman",
            "tray"
        ]
    },

// Load Modules

  "include": ["~/.config/waybar/modules.jsonc"],

}
