{
"sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}"
    },
    "custom/arch-logo": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Edit Waybar config",
        "on-click": "kitty --class waybar-config --title 'Waybar Config' --directory /home/dawrin/dotfiles/config/waybar nvim config.jsonc",
        "on-click-right": "swaymsg reload && swaymsg 'exec --no-startup-id /home/dawrin/.config/waybar/scripts/restart-waybar.sh'"
    },
    "sway/mode": { "format": " {name} " },

    "clock": {
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "W{}",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    },
    "format": "{:%a %d %b | %I:%M %p}", //12 hour format
    "format-alt": "  {:%Y-%m-%d  %H:%M:%S}",
    "interval": 1
  },

//    "clock": {
//        "format": "{:%a %d %b  %H:%M}",
//        "tooltip-format": "{:%Y-%m-%d}"
//    },

    "network": {
        "format": "⚠ Disabled",
        "format-wifi": " {essid}",
        "format-ethernet": " Wired",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": " {essid} ({signalStrength}%)",
        "tooltip-format-ethernet": " {ifname} ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "⚠ Disconnected",
        "on-click": "kitty --class waybar-network --title impala -e impala"
    },
    
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "kitty --class waybar-audio --title 'Audio Mixer' -e pulsemixer"
    },


    "cpu": {
        "format": " {usage: >3}%",
        "on-click": "kitty --class waybar-system --title btop -e btop"
    },
    "memory": {
        "format": " {percentage: >3}%",
        "on-click": "kitty --class waybar-system --title btop -e btop"
    },
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity: >3}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },

  "mpris": {
    "player": "playerctld",
    "format": " {artist} — {title}",
    "format-paused": " {artist} — {title}",
    "format-stopped": "",
    "tooltip-format": "{player}: {artist} — {album} — {title}",
    "max-length": 34,
    "interval": 2
  },

  //

  "custom/media-prev": {
    "exec-if": "playerctl --player=playerctld status",
    "format": "",
    "tooltip": true,
    "tooltip-format": "Previous track",
    "on-click": "playerctl --player=playerctld previous"
  },
  "custom/media-toggle": {
    "exec-if": "playerctl --player=playerctld status",
    "exec": "playerctl --player=playerctld status 2>/dev/null | sed -e 's/^Playing$//' -e 's/^Paused$//' -e 's/^Stopped$//'",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Play / pause",
    "on-click": "playerctl --player=playerctld play-pause"
  },
  "custom/media-next": {
    "exec-if": "playerctl --player=playerctld status",
    "format": "",
    "tooltip": true,
    "tooltip-format": "Next track",
    "on-click": "playerctl --player=playerctld next"
  },
  "custom/cava-internal": {
    "exec": "bash ~/.config/waybar/scripts/Cava.sh",
    "format": "{}",
    "tooltip": false,
    "layer": "below",
    "output": "all"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  
  "disk": {
    // "interval": 30,
    "format": " {percentage_used}% ",
    "path": "/",
    "on-click": "kitty --class waybar-system --title btop -e btop"
  },
  "backlight": {

    "format": "{icon} {percent: >3}%",
    // "format-icons": ["", ""],
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-down": "brightnessctl -c backlight set 5%-",
    // "on-scroll-down": "light -A 5 && light -G | cut -d'.' -f1 > $SWAYSOCK.wob",
    "on-scroll-up": "brightnessctl -c backlight set +5%",
    // "on-scroll-up": "light -U 5 && light -G | cut -d'.' -f1 > $SWAYSOCK.wob"
    "on-click": ""
  },
  "custom/pacman": {
    "return-type": "json",
    "format": "{text}",
    "tooltip": true,
    "interval": 7200,
    "exec": "~/.config/waybar/scripts/checkupdates-waybar.sh",
    "on-click": "kitty --hold --class waybar-system --title 'Official Repo Upgrade' -e sudo pacman -Syu",
    "signal": 8
  },
  "custom/power": {
    "format": "⏻",
    // "on-click": "wlogout -p layer-shell",
    "on-click": "~/.config/rofi/powermenu/power-menu.sh",
    "tooltip": false
  },


    "tray": { "spacing": 8, "icon-size": 16 }
}
}
