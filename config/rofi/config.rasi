/* ~/.config/rofi/config.rasi — launched with: rofi -show drun */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "kitty";
}

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: #c0caf5;
}

window {
    width: 740px;
    background-color: #1a1b26ee;
    border: 2px;
    border-color: #7aa2f7;
    border-radius: 8px;
    padding: 12px;
}

inputbar { padding: 4px 8px 10px 8px; }
prompt   { padding-right: 8px; color: #7aa2f7; }

listview { lines: 8; spacing: 4px; }

element          { padding: 6px 8px; border-radius: 4px; }
element selected { background-color: #7aa2f7; text-color: #1a1b26; }
element-icon     { size: 1.4em; }
