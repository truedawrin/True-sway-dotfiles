#!/usr/bin/env bash
set -Eeuo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_dir="$runtime_dir/sway-screen-recorder-${UID}"
mkdir -p -- "$state_dir" "$HOME/Videos"
lock_file="$state_dir/lock"
pid_file="$state_dir/pid"
state_file="$state_dir/status"

write_state() {
    local state="$1" tmp="$state_dir/status.tmp.$$"
    printf '%s\n' "$state" > "$tmp"
    mv -f -- "$tmp" "$state_file"
    # Refresh the custom module immediately; keep the 1 s poll as a fallback.
    pkill -RTMIN+8 -x waybar 2>/dev/null || true
}

show_status() {
    local state="" pid=""
    exec 8>"$lock_file"
    if flock -n 8; then
        rm -f -- "$state_file" "$pid_file"
    else
        [[ -r "$state_file" ]] && IFS= read -r state < "$state_file" || true
    fi
    case "$state" in
        selecting)
            printf '{"text":"…","class":"selecting","tooltip":"Select a region · Escape cancels"}\n'
            ;;
        countdown:*)
            printf '{"text":" %s","class":"countdown","tooltip":"Recording starts shortly"}\n' "${state#countdown:}"
            ;;
        recording:*)
            local started="${state#recording:}" now elapsed
            now="$(date +%s)"
            elapsed=$((now - started))
            ((elapsed < 0)) && elapsed=0
            printf '{"text":"⏺ %02d:%02d","class":"recording","tooltip":"Recording · click or press Mod+Shift+A to stop"}\n' \
                "$((elapsed / 60))" "$((elapsed % 60))"
            ;;
        *)
            printf '{"text":"","class":"idle","tooltip":"Record a screen region"}\n'
            ;;
    esac
}

toggle_recording() {
    exec 9>"$lock_file"
    if flock -n 9; then
        printf '%s\n' "$$" > "$pid_file"
        record_region
    else
        local pid=""
        [[ -r "$pid_file" ]] && IFS= read -r pid < "$pid_file" || true
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            kill -INT "$pid" 2>/dev/null || true
        fi
    fi
}

record_region() {
    local selection_file="" geometry="" sink="" mic_source="" mix_sink="" output="" suffix=0
    local child_pid="" child_kind="" countdown
    local -a module_ids=()

    cleanup() {
        local exit_code=$?
        trap - EXIT INT TERM
        if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null; then
            if [[ "$child_kind" == recorder ]]; then
                kill -INT "$child_pid" 2>/dev/null || true
            else
                kill -TERM "$child_pid" 2>/dev/null || true
            fi
            wait "$child_pid" 2>/dev/null || true
        fi
        for ((i=${#module_ids[@]}-1; i>=0; i--)); do
            pactl unload-module "${module_ids[$i]}" >/dev/null 2>&1 || true
        done
        rm -f -- "$state_file" "$pid_file"
        [[ -z "$selection_file" ]] || rm -f -- "$selection_file"
        if [[ -n "$output" && -s "$output" ]] && command -v notify-send >/dev/null; then
            notify-send -a "Screen Recorder" -i camera-video "Recording saved" "$output" >/dev/null 2>&1 || true
        elif ((exit_code != 0)) && command -v notify-send >/dev/null; then
            notify-send -a "Screen Recorder" -i dialog-error "Screen recording failed" \
                "Check wf-recorder and PipeWire audio." >/dev/null 2>&1 || true
        fi
    }

    trap cleanup EXIT
    trap 'exit 0' INT TERM

    if ! command -v slurp >/dev/null || ! command -v wf-recorder >/dev/null; then
        printf 'Install slurp and wf-recorder before recording.\n' >&2
        exit 1
    fi

    write_state selecting
    selection_file="$state_dir/selection.$$"
    slurp > "$selection_file" &
    child_pid=$!
    child_kind=selector
    if ! wait "$child_pid"; then
        child_pid=""
        exit 0
    fi
    child_pid=""
    geometry="$(<"$selection_file")"
    [[ -n "$geometry" ]] || exit 0

    if ! command -v pactl >/dev/null; then
        printf 'pactl is required to mix system audio and microphone input.\n' >&2
        exit 1
    fi
    sink="$(pactl get-default-sink)"
    mic_source="$(pactl get-default-source 2>/dev/null || true)"
    [[ -n "$sink" ]] || { printf 'No default audio output is available.\n' >&2; exit 1; }

    mix_sink="wfrec_mix_${UID}_$$"
    module_ids+=("$(pactl load-module module-null-sink sink_name="$mix_sink" \
        sink_properties=device.description=ScreenRecorderMix)")
    module_ids+=("$(pactl load-module module-loopback source="${sink}.monitor" \
        sink="$mix_sink" latency_msec=40)")
    if [[ -n "$mic_source" && "$mic_source" != "${sink}.monitor" && "$mic_source" != *.monitor ]]; then
        module_ids+=("$(pactl load-module module-loopback source="$mic_source" \
            sink="$mix_sink" latency_msec=40)")
    fi

    output="$HOME/Videos/Screen-recording-$(date +%Y%m%d-%H%M%S).mp4"
    while [[ -e "$output" ]]; do
        ((suffix+=1))
        output="$HOME/Videos/Screen-recording-$(date +%Y%m%d-%H%M%S)-$suffix.mp4"
    done

    for countdown in 3 2 1; do
        write_state "countdown:$countdown"
        sleep 1 &
        child_pid=$!
        child_kind=sleep
        wait "$child_pid" || true
        child_pid=""
    done

    write_state "recording:$(date +%s)"
    wf-recorder --audio="${mix_sink}.monitor" --geometry="$geometry" --file="$output" \
        > "$state_dir/wf-recorder.log" 2>&1 &
    child_pid=$!
    child_kind=recorder
    wait "$child_pid" || exit 1
    child_pid=""
}

case "${1:---toggle}" in
    --toggle) toggle_recording ;;
    --status) show_status ;;
    *) printf 'Usage: %s [--toggle|--status]\n' "$0" >&2; exit 2 ;;
esac
